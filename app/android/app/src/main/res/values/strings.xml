    <string name="about_title">Acerca de nosotros</string>
    <string name="about_commitment">Innovación con inteligencia artificial para la gulupa</string>
    <string name="about_mission_t">Nuestra misión</string>
    <string name="about_mission">Empoderar a los productores y exportadores de gulupa mediante visión por computadora en el dispositivo móvil, permitiendo la cuantificación automática de severidad de sarna (roña), antracnosis y mancha de aceite para garantizar la calidad exportable.</string>
    <string name="about_team_t">Equipo y desarrollo</string>
    <string name="about_course">Desarrollo de Aplicaciones para Dispositivos Móviles · Universidad Nacional de Colombia</string>
    <string name="about_how_t">Cómo funciona la IA</string>
    <string name="how1">Fotografía o selecciona una imagen de gulupa centrada.</string>
    <string name="how2">El Modelo A (YOLO26n-seg) aísla el fruto y elimina el fondo.</string>
    <string name="how3">El Modelo B detecta y segmenta sarna, antracnosis y mancha de aceite.</string>
    <string name="how4">Se cuantifica el % de severidad y clasificación de calidad.</string>
    <string name="how5">Generas el reporte técnico y la ficha en PDF para compartir.</string>
    <string name="about_scope_t">Modelos integrados</string>
    <string name="about_scope">Dos redes neuronales YOLO26n-seg cuantizadas en int8 (3.1 MB y 3.2 MB) integradas mediante ONNX Runtime para ejecución inmediata en el teléfono sin internet.</string>
    <string name="about_base">GuluScan · Universidad Nacional de Colombia</string>
