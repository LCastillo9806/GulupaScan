    <string name="dmg_fruit">Fruto / Fruta</string>
    <string name="dmg_fruit_desc">Superficie detectada del fruto de gulupa.</string>
    <string name="dmg_scab">Sarna (Roña)</string>
    <string name="dmg_scab_desc">Lesiones corchosas y redondeadas de color pardo o marrón claro sobre la cáscara (Cladosporium oxysporum / Cladosporium cladosporioides).</string>
    <string name="dmg_anthracnose">Antracnosis</string>
    <string name="dmg_anthracnose_desc">Manchas necróticas circulares hundidas de tonalidad oscura con centros agrietados (Colletotrichum gloeosporioides).</string>
    <string name="dmg_oil_spot">Mancha de aceite</string>
    <string name="dmg_oil_spot_desc">Lesiones acuosas, translúcidas u oleosas de aspecto grasoso causadas por bacterias fitopatógenas (Xanthomonas axonopodis pv. passiflorae).</string>
    <string name="dmg_mechanical">Daño mecánico</string>
    <string name="dmg_mechanical_desc">Golpes, rozaduras o cortes producidos en cosecha, empaque o transporte.</string>
    <string name="dmg_thrips">Trips</string>
    <string name="dmg_thrips_desc">Raspaduras plateadas o bronceadas causadas por la alimentación de insectos trips.</string>
    <string name="dmg_mildew">Mildiu polvoso</string>
    <string name="dmg_mildew_desc">Manchas blancas polvorientas del hongo sobre el tejido vegetal.</string>
    <string name="dmg_healthy">Fruto sano</string>
    <string name="dmg_healthy_desc">Área de tejido epidérmico libre de lesiones o patógenos visibles.</string>
    <string name="dmg_unknown">Otro daño</string>
    <string name="dmg_unknown_desc">Tipo de lesión reportada por el modelo que aún no está clasificada en el catálogo.</string>

