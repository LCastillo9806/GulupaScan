    <string name="about_title">About us</string>
    <string name="about_commitment">AI innovation for purple passion fruit growers</string>
    <string name="about_mission_t">Our mission</string>
    <string name="about_mission">Empower purple passion fruit producers and exporters using on-device mobile computer vision, enabling automated severity estimation of scab, anthracnose and oil spot to ensure export quality.</string>
    <string name="about_team_t">Team &amp; development</string>
    <string name="about_course">Mobile Application Development · Universidad Nacional de Colombia</string>
    <string name="about_how_t">How the AI works</string>
    <string name="how1">Take or pick a clear, centered photo of the gulupa.</string>
    <string name="how2">Model A (YOLO26n-seg) isolates the fruit and removes background.</string>
    <string name="how3">Model B detects and segments scab, anthracnose and oil spot.</string>
    <string name="how4">Severity percentage and commercial quality tier are calculated.</string>
    <string name="how5">Generate technical reports and PDF summary sheets to share.</string>
    <string name="about_scope_t">Integrated models</string>
    <string name="about_scope">Two int8 quantized YOLO26n-seg neural networks (3.1 MB and 3.2 MB) deployed via ONNX Runtime for instant on-device execution without internet.</string>
    <string name="about_base">GuluScan · Universidad Nacional de Colombia</string>
